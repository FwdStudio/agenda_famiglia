<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="accent512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#22c55e" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.3"/>
    </filter>
  </defs>

  <!-- Base App Icon con Sfondo -->
  <rect width="512" height="512" rx="112" fill="url(#bg512)" />

  <g filter="url(#shadow)">
    <!-- Griglia / Struttura Calendario -->
    <rect x="96" y="116" width="320" height="300" rx="44" fill="none" stroke="#f8fafc" stroke-width="20" />
    <path d="M96 200 h320" stroke="#f8fafc" stroke-width="20" />
    
    <!-- Ganci Calendario -->
    <line x1="172" y1="84" x2="172" y2="128" stroke="url(#accent512)" stroke-width="20" stroke-linecap="round" />
    <line x1="340" y1="84" x2="340" y2="128" stroke="url(#accent512)" stroke-width="20" stroke-linecap="round" />

    <!-- Iconografia Famiglia (Adulto + Bambino) -->
    <!-- Adulto -->
    <circle cx="192" cy="268" r="22" fill="url(#accent512)" />
    <path d="M154 356 c0-32 20-48 38-48 s38 16 38 48" fill="none" stroke="url(#accent512)" stroke-width="18" stroke-linecap="round" />

    <!-- Bambino -->
    <circle cx="268" cy="292" r="16" fill="#f8fafc" />
    <path d="M240 356 c0-22 16-32 28-32 s28 10 28 32" fill="none" stroke="#f8fafc" stroke-width="14" stroke-linecap="round" />

    <!-- Elemento Sportivo (Pallone da Calcio / Sport) -->
    <g transform="translate(336, 280)">
      <circle cx="0" cy="0" r="28" fill="none" stroke="url(#accent512)" stroke-width="14" />
      <path d="M-12 -12 L12 12 M12 -12 L-12 12" stroke="url(#accent512)" stroke-width="8" stroke-linecap="round" />
    </g>
  </g>
</svg>
